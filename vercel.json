{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/league/:slug", "destination": "/index.html" }
  ],
  "functions": {
    "api/shared.js": {
      "maxDuration": 60
    },
    "api/espn/import.js": {
      "maxDuration": 60
    }
  }
}
