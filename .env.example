# Local API port. Vite proxies /api requests to port 8787 by default.
PORT=8787

# Import/refresh protection. These defaults are suitable for local use.
ESPN_RATE_MAX=6
ESPN_RATE_WINDOW_MS=60000
ESPN_LEAGUE_COOLDOWN_MS=15000

# Optional shared link: /league/my-league. Configure real values in Vercel's
# server environment variables (or an ignored local .env), never in this file.
# Use your league ID to enable sharing; use off to disable.
ESPN_LEAGUE_ID=off
ESPN_SEASON=2026
# Private leagues only: paste values alone, keeping the SWID braces.
ESPN_SWID=
ESPN_S2=
