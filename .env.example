# Local API port. Vite proxies /api requests to port 8787 by default.
PORT=8787

# Import/refresh protection. These defaults are suitable for local use.
ESPN_RATE_MAX=6
ESPN_RATE_WINDOW_MS=60000
ESPN_LEAGUE_COOLDOWN_MS=15000

# Never put SWID or ESPN_S2 here. Enter them only in the private-league
# import form; the server uses them for that ESPN request and discards them.
